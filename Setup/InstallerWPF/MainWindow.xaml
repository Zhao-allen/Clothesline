<Window x:Class="ClotheslineSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clothesline Setup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="720"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei, sans-serif">

  <Window.Resources>
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#64748b"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="MainBorder" CornerRadius="18" BorderThickness="1" Margin="20">
    <Border.Effect>
      <DropShadowEffect Color="#30000000" Direction="270" ShadowDepth="12" BlurRadius="40" Opacity="0.5"/>
    </Border.Effect>

    <Grid>
      <!-- Glass background fill -->
      <Border x:Name="GlassBorder" CornerRadius="18" Background="Transparent"/>
      <!-- Highlight overlay (::before) -->
      <Border x:Name="HighlightBorder" CornerRadius="18" Background="Transparent" IsHitTestVisible="False"/>

      <!-- Content -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="38"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titlebar -->
        <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Margin="0,0,6,0">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop x:Name="DotGradientStart" Color="#3b82f6" Offset="0"/>
                  <GradientStop x:Name="DotGradientEnd" Color="#6366f1" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="TitleBarText" Text="Clothesline 0.3.0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>

          <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource ChromeButton}"
                  Content="×" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Click="CloseButton_Click"/>
          <Border x:Name="TitleBarBorder" Height="1" VerticalAlignment="Bottom" Grid.ColumnSpan="3" Background="Transparent"/>
        </Grid>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="36,30,36,26">
          <!-- Brand -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,12,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop x:Name="LogoGradientStart" Color="#3b82f6" Offset="0"/>
                  <GradientStop x:Name="LogoGradientEnd" Color="#6366f1" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Path Data="M3,6 L21,6 L19,19 L5,19 Z M8,6 V4 A4,4 0 0,1 16,4 V6"
                    Stroke="White" StrokeThickness="2.4" Stretch="Uniform" Margin="11"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="BrandTitleText" Text="Clothesline" FontSize="26" FontWeight="ExtraBold" LineHeight="1.1"/>
              <TextBlock x:Name="BrandTaglineText" FontSize="12.5" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- Divider -->
          <Border x:Name="DividerBorder" Height="1" Margin="0,4,0,22" Background="Transparent"/>

          <!-- Install sections -->
          <StackPanel x:Name="InstallSections">
            <!-- Language -->
            <StackPanel Margin="0,0,0,22">
              <TextBlock x:Name="LanguageLabel" FontSize="11" FontWeight="Bold" Margin="0,0,0,11"/>
              <StackPanel x:Name="LanguageRow" Orientation="Horizontal">
                <Button x:Name="LangEn" Style="{StaticResource PillButton}" Content="English" Tag="en" Click="LangButton_Click"/>
                <Button x:Name="LangZh" Style="{StaticResource PillButton}" Content="中文" Tag="zh" Click="LangButton_Click" Margin="8,0,0,0"/>
                <Button x:Name="LangEs" Style="{StaticResource PillButton}" Content="Español" Tag="es" Click="LangButton_Click" Margin="8,0,0,0"/>
                <Button x:Name="LangJa" Style="{StaticResource PillButton}" Content="日本語" Tag="ja" Click="LangButton_Click" Margin="8,0,0,0"/>
                <Button x:Name="LangFr" Style="{StaticResource PillButton}" Content="Français" Tag="fr" Click="LangButton_Click" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>

            <!-- Welcome -->
            <StackPanel Margin="0,0,0,22">
              <TextBlock x:Name="WelcomeTitle" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,8"/>
              <TextBlock x:Name="WelcomeBody" FontSize="13.5" TextWrapping="Wrap" LineHeight="1.65" Margin="0,0,0,10"/>
              <Border x:Name="HintCard" CornerRadius="10" BorderThickness="1" Padding="10,12">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="HintIcon" Data="M12,2 A10,10 0 1,1 12,22 A10,10 0 1,1 12,2 M12,16 V12 M12,8 H12.01"
                        StrokeThickness="2" Stretch="Uniform" Width="16" Height="16" Margin="0,1,8,0"/>
                  <TextBlock x:Name="HintText" FontSize="12.5" TextWrapping="Wrap" LineHeight="1.55"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Location -->
            <StackPanel x:Name="LocationSection" Margin="0,0,0,0">
              <TextBlock x:Name="LocationLabel" FontSize="11" FontWeight="Bold" Margin="0,0,0,11"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PathFieldBorder" Grid.Column="0" Height="38" CornerRadius="9" BorderThickness="1" Padding="12,0">
                  <TextBox x:Name="PathBox" VerticalContentAlignment="Center" FontSize="12.5"
                           FontFamily="Cascadia Code, Consolas, monospace" BorderThickness="0"
                           Background="Transparent" FocusVisualStyle="{x:Null}"/>
                </Border>
                <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource ActionButton}"
                        Content="Browse..." Margin="8,0,0,0" Click="BrowseButton_Click"/>
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- Uninstall sections -->
          <StackPanel x:Name="UninstallSections" Visibility="Collapsed">
            <TextBlock x:Name="UninstallTitle" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="UninstallBody" FontSize="13.5" TextWrapping="Wrap" LineHeight="1.65" Margin="0,0,0,10"/>
            <TextBlock x:Name="UninstallPath" FontSize="13.5" Margin="0,10,0,0"
                       FontFamily="Cascadia Code, Consolas, monospace" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <!-- Done sections -->
          <StackPanel x:Name="DoneSections" Visibility="Collapsed">
            <Border x:Name="OkBanner" CornerRadius="14" BorderThickness="1" Padding="18,20" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop x:Name="OkBadgeGradientStart" Color="#10b981" Offset="0"/>
                      <GradientStop x:Name="OkBadgeGradientEnd" Color="#14b8a6" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Path Data="M20,6 L9,17 L4,12" Stroke="White" StrokeThickness="3" Stretch="Uniform" Margin="11"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="OkHeading" FontSize="16.5" FontWeight="ExtraBold" LineHeight="1.2"/>
                  <TextBlock x:Name="OkSubtext" FontSize="12.5" Margin="0,4,0,0" LineHeight="1.5"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="DoneBodyText" FontSize="13.5" TextWrapping="Wrap" LineHeight="1.65" Margin="0,0,0,18"/>
            <Border x:Name="LaunchCheckRow" CornerRadius="10" BorderThickness="1" Padding="10,12" Margin="0,0,0,6"
                    MouseLeftButtonDown="LaunchCheckRow_Click" Cursor="Hand">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="LaunchCheckBox" Width="18" Height="18" CornerRadius="5" Margin="0,0,10,0">
                  <Path x:Name="LaunchCheckMark" Data="M20,6 L9,17 L4,12" Stroke="White" StrokeThickness="3.5"
                        Stretch="Uniform" Margin="3" Visibility="Collapsed"/>
                </Border>
                <Path x:Name="LaunchPlayIcon" Data="M5,3 L19,12 L5,21 Z" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0"/>
                <TextBlock x:Name="LaunchCheckText" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Status + Progress -->
          <TextBlock x:Name="StatusText" Visibility="Collapsed" FontSize="13" Margin="0,12,0,4"/>
          <Border x:Name="ProgressBarTrack" Height="6" CornerRadius="3" Visibility="Collapsed" Margin="0,0,0,12">
            <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" Height="6" CornerRadius="3"/>
          </Border>

          <!-- Action separator -->
          <Border x:Name="ActionSeparator" Height="1" Margin="0,18,0,0" Background="Transparent"/>

          <!-- Actions -->
          <StackPanel x:Name="ActionRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SecondaryButton" Style="{StaticResource ActionButton}" Content="Cancel"
                    Click="SecondaryButton_Click"/>
            <Button x:Name="PrimaryButton" Style="{StaticResource ActionButton}"
                    Margin="10,0,0,0" Click="PrimaryButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="PrimaryIcon" Data="M21,15 V19 A2,2 0 0,1 19,21 H5 A2,2 0 0,1 3,19 V15 M7,10 L12,15 L17,10 M12,15 V3"
                      Stroke="White" StrokeThickness="2.2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0"/>
                <TextBlock x:Name="PrimaryLabel" Text="Install" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
