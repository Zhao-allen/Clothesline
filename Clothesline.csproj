<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\Clothesline.ico</ApplicationIcon>
    <RootNamespace>Clothesline</RootNamespace>
    <AssemblyName>Clothesline</AssemblyName>
    <!-- Without this the assembly version defaults to 1.0.0 and the tray
         menu header shows "v1.0.0". Kept in step with the release tag. -->
    <Version>0.3.2</Version>
    <SatelliteResourceLanguages>en;es;zh;ja;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer lives in Setup/ but is built as its own solution-less
         project by build.ps1 and the release workflow. The default **/*.cs
         glob would otherwise pull its WinForms sources into this WPF app. -->
    <Compile Remove="Setup/**/*.cs" />
    <Page Remove="Setup/**/*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <CustomToolNamespace>Clothesline.Resources</CustomToolNamespace>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.es.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.zh.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.ja.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.fr.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Donation QR code.

         Two entries on purpose:
         * <Resource> embeds it in the assembly so the installed app always
           finds it via pack://application:,,, regardless of layout.
         * <Content> copies it next to the exe so the file fallback in
           DonationWindow.LoadQrImage works when running from the build
           output, and so the file is visible/editable for a user dropping in
           their own code. -->
    <Resource Include="Resources\donation_qr_wechat.png" />
    <Content Include="Resources\donation_qr_wechat.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Resources\donation_qr_wechat.png</TargetPath>
    </Content>

    <Resource Include="Resources\donation_qr_alipay.png" />
    <Content Include="Resources\donation_qr_alipay.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Resources\donation_qr_alipay.png</TargetPath>
    </Content>
  </ItemGroup>

</Project>
